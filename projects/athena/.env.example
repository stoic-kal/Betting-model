# Athena — Environment Variables
# Copy to .env.local for local development

# Flask API base URL (proxied by Vite in dev)
VITE_API_BASE_URL=http://localhost:3000

# Athena AI — OpenAI-compatible endpoint
VITE_ATHENA_AI_URL=http://localhost:3000/api/athena/chat
VITE_ATHENA_AI_KEY=

# Feature flags
VITE_ENABLE_VOICE=true
VITE_ENABLE_AI_PANEL=true
VITE_ENABLE_EXPERIMENTS=true
VITE_DEBUG_MODE=false

# Analytics (optional)
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=
